{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/src/**)",
      "Write(/src/**)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm view *)",
      "Bash(npm outdated*)",
      "Bash(npx ng generate *)",
      "Bash(npx ng g *)",
      "Bash(npx ng lint*)",
      "Bash(npx ng build*)",
      "Bash(npx ng version*)",
      "Bash(npx jest*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx tsc*)",
      "Bash(npx ngc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npx ng generate *)",
      "PowerShell(npx ng g *)",
      "PowerShell(npx jest*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "mcp__angular-cli"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npx ng add *)",
      "Bash(npx ng update *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(rm *)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": ["Read(/.env)", "Read(/.env.*)"]
  },
  "enabledMcpjsonServers": ["angular-cli"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
